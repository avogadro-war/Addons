# Exclude RAR files
*.rar

# Exclude temporary and system files
*.tmp
*.temp
*.bak
*.backup
*.log
logs/
debug_*.lua
test_*.lua

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
